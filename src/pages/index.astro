---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Twelve weeks of producing convincing, unverifiable claims under a clock,
    building toward two oral exams where the only thing checked is whether
    you can hold a position out loud. You leave with a portfolio of bits, one
    genuine attempt for comparison, and a reasonably accurate read on your
    own tells.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who has already finished <em>Calling Bullshit</em> and wants the
    other side of the trade. No prior bullshitting experience assumed; a
    willingness to say something with total confidence before checking
    whether it's true is the only real prerequisite.
  </p>

  <p>
    This site was built the way the course teaches: fast, with an agent doing
    most of the typing and a human reviewing the brief. Neither of us is
    claiming that's a coincidence.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Lectures" href="/lectures/">
      <p>Twelve weeks, three learning outcomes, one recurring bit.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
